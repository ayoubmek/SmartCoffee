{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="row g-5 g-xl-10 mb-5 mb-xl-10">
    <!-- Page Title -->
    <div class="col-12">
        <h1 class="text-gray-900 fw-bold mb-3">Tableau de bord</h1>
        <p class="text-gray-600">Bienvenue dans votre panneau d'administration</p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row g-5 g-xl-10 mb-5 mb-xl-10">
    <!-- Total Products -->
    <div class="col-md-6 col-lg-6 col-xl-4 col-xxl-3">
        <div class="card card-flush h-md-50 mb-5 mb-xl-10" style="background: linear-gradient(135deg, #e3c77a, #caa44c);">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <span class="fs-2hx fw-bold text-white me-2 lh-1 ls-n2">{{ totalProducts }}</span>
                    <span class="text-white opacity-75 pt-1 fw-semibold fs-6">Produits</span>
                </div>
            </div>
            <div class="card-body d-flex align-items-end pt-0">
                <div class="d-flex align-items-center flex-column mt-3 w-100">
                    <div class="d-flex justify-content-between fw-bold fs-6 text-white opacity-75 w-100 mt-auto mb-2">
                        <span>Total</span>
                        <span>100%</span>
                    </div>
                    <div class="h-8px mx-3 w-100 bg-white bg-opacity-50 rounded">
                        <div class="bg-white rounded h-8px" role="progressbar" style="width: 100%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Categories -->
    <div class="col-md-6 col-lg-6 col-xl-4 col-xxl-3">
        <div class="card card-flush h-md-50 mb-5 mb-xl-10" style="background: linear-gradient(135deg, #8c6e2f, #caa44c);">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <span class="fs-2hx fw-bold text-white me-2 lh-1 ls-n2">{{ totalCategories }}</span>
                    <span class="text-white opacity-75 pt-1 fw-semibold fs-6">Catégories</span>
                </div>
            </div>
            <div class="card-body d-flex align-items-end pt-0">
                <div class="d-flex align-items-center flex-column mt-3 w-100">
                    <div class="d-flex justify-content-between fw-bold fs-6 text-white opacity-75 w-100 mt-auto mb-2">
                        <span>Total</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Users -->
    <div class="col-md-6 col-lg-6 col-xl-4 col-xxl-3">
        <div class="card card-flush h-md-50 mb-5 mb-xl-10" style="background: linear-gradient(135deg, #c79b33, #ffbc21);">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <span class="fs-2hx fw-bold text-white me-2 lh-1 ls-n2">{{ totalUsers }}</span>
                    <span class="text-white opacity-75 pt-1 fw-semibold fs-6">Utilisateurs</span>
                </div>
            </div>
            <div class="card-body d-flex align-items-end pt-0">
                <div class="d-flex align-items-center flex-column mt-3 w-100">
                    <div class="d-flex justify-content-between fw-bold fs-6 text-white opacity-75 w-100 mt-auto mb-2">
                        <span>Clients</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Revenue -->
    <div class="col-md-6 col-lg-6 col-xl-4 col-xxl-3">
        <div class="card card-flush h-md-50 mb-5 mb-xl-10" style="background: linear-gradient(135deg, #ffbc21, #e3c77a);">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <span class="fs-2hx fw-bold text-white me-2 lh-1 ls-n2">{{ totalRevenue|number_format(0, ',', '.') }}</span>
                    <span class="text-white opacity-75 pt-1 fw-semibold fs-6">DT Revenus</span>
                </div>
            </div>
            <div class="card-body d-flex align-items-end pt-0">
                <div class="d-flex align-items-center flex-column mt-3 w-100">
                    <div class="d-flex justify-content-between fw-bold fs-6 text-white opacity-75 w-100 mt-auto mb-2">
                        <span>{{ totalOrders }} Commandes</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders & Products -->
<div class="row g-5 g-xl-10">
    <!-- Recent Orders -->
    <div class="col-xl-6">
        <div class="card card-flush h-md-100">
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">Commandes récentes</span>
                    <span class="text-gray-400 mt-1 fw-semibold fs-6">Dernières {{ recentOrders|length }} commandes</span>
                </h3>
            </div>
            <div class="card-body pt-6">
                <div class="table-responsive">
                    <table class="table table-row-dashed align-middle gs-0 gy-3 my-0">
                        <thead>
                            <tr class="fs-7 fw-bold text-gray-400 border-bottom-0">
                                <th class="p-0 pb-3 min-w-100px">ID</th>
                                <th class="p-0 pb-3 min-w-100px">Total</th>
                                <th class="p-0 pb-3 min-w-150px text-end">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in recentOrders %}
                            <tr>
                                <td><span class="text-gray-800 fw-bold">#{{ order.id }}</span></td>
                                <td><span class="badge badge-light-success">{{ order.total }} DT</span></td>
                                <td class="text-end pe-0"><span class="text-gray-600 fw-bold">{{ order.createdAt is defined ? order.createdAt|date('d/m/Y') : 'N/A' }}</span></td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-gray-500">Aucune commande</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Products -->
    <div class="col-xl-6">
        <div class="card card-flush h-md-100">
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-gray-800">Produits récents</span>
                    <span class="text-gray-400 mt-1 fw-semibold fs-6">Derniers {{ recentProducts|length }} produits ajoutés</span>
                </h3>
            </div>
            <div class="card-body pt-6">
                <div class="table-responsive">
                    <table class="table table-row-dashed align-middle gs-0 gy-3 my-0">
                        <thead>
                            <tr class="fs-7 fw-bold text-gray-400 border-bottom-0">
                                <th class="p-0 pb-3 min-w-175px">Produit</th>
                                <th class="p-0 pb-3 min-w-100px">Prix</th>
                                <th class="p-0 pb-3 min-w-100px text-end">Catégorie</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in recentProducts %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="symbol symbol-50px me-3">
                                            <img src="{{ asset(product.image) }}" alt="{{ product.nom }}" class="w-100">
                                        </div>
                                        <div class="d-flex justify-content-start flex-column">
                                            <span class="text-gray-800 fw-bold text-hover-primary mb-1 fs-6">{{ product.nom }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="text-gray-800 fw-bold">{{ product.prix }} DT</span></td>
                                <td class="text-end"><span class="badge badge-light">{{ product.categorie.nom }}</span></td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-gray-500">Aucun produit</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-5 g-xl-10 mt-5">
    <div class="col-12">
        <div class="card card-flush">
            <div class="card-header">
                <h3 class="card-title">Actions rapides</h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-3">
                    <a href="{{ path('admin_produit_new') }}" class="btn btn-primary">
                        <i class="ki-duotone ki-plus fs-2"></i>
                        Nouveau Produit
                    </a>
                    <a href="{{ path('admin_categorie_new') }}" class="btn btn-primary">
                        <i class="ki-duotone ki-plus fs-2"></i>
                        Nouvelle Catégorie
                    </a>
                    <a href="{{ path('admin_offer_new') }}" class="btn btn-primary">
                        <i class="ki-duotone ki-plus fs-2"></i>
                        Nouvelle Offre
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
