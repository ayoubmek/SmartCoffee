<div class="modal-header" id="kt_modal_edit_category_header_{{ categorie.id }}">
    <h2 class="fw-bold">Edit category</h2>
    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
        <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
    </div>
</div>

{{ form_start(form, {
    'attr': {
        'id': 'kt_modal_edit_category_form_' ~ categorie.id,
        'class': 'form',
        'enctype': 'multipart/form-data'
    }
}) }}

<div class="modal-body px-5 my-7">
    <div class="d-flex flex-column scroll-y px-5 px-lg-10"
            data-kt-scroll="true"
            data-kt-scroll-max-height="auto"
            data-kt-scroll-offset="300px">

        <div class="fv-row mb-7">
            <label class="required fw-semibold fs-6 mb-2">Name</label>
            {{ form_widget(form.nom, {'attr': {'class': 'form-control form-control-solid'}}) }}
            {{ form_errors(form.nom) }}
        </div>

        <div class="fv-row mb-7">
            <label class="d-block fw-semibold fs-6 mb-5">Icon image</label>

            <div class="image-input image-input-outline {% if not categorie.icone %}image-input-placeholder{% endif %}"
                    data-kt-image-input="true" id="image-input-edit-{{ categorie.id }}">
                <div class="image-input-wrapper w-125px h-125px" 
                    {% if categorie.icone %}
                        style="background-image: url('{{ asset(categorie.icone) }}')"
                    {% endif %}>
                </div>

                <label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow"
                    data-kt-image-input-action="change" data-bs-toggle="tooltip" title="Change icon">
                    <i class="ki-duotone ki-pencil fs-7">
                    <span class="path1"></span>
                    <span class="path2"></span>
                    </i>
                    {{ form_widget(form.iconeFile, {
                        'label': false,
                        'attr': {
                            'class': 'd-none',
                            'accept': '.png,.jpg,.jpeg,.webp',
                            'data-edit-id': categorie.id
                        }
                    }) }}
                </label>

                <input type="hidden" name="icone_remove" value="0">
                
                <!-- Cancel button -->
                <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow" 
                    data-kt-image-input-action="cancel" data-bs-toggle="tooltip" title="Cancel icon">
                    <i class="ki-duotone ki-cross fs-2"></i>
                </span>

                <!-- Remove button -->
                <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow" 
                    data-kt-image-input-action="remove" data-bs-toggle="tooltip" title="Remove icon">
                    <i class="ki-duotone ki-cross fs-2"></i>
                </span>

            </div>

            <div class="form-text">Allowed file types: png, jpg, jpeg,webp.</div>
            {{ form_errors(form.iconeFile) }}
        </div>
    </div>
</div>

<div class="modal-footer text-center">
    <button type="reset" class="btn btn-light me-3" data-bs-dismiss="modal">Discard</button>
    <button type="submit" class="btn btn-primary">
        <span class="indicator-label">Update</span>
        <span class="indicator-progress" style="display:none;">
            Please wait...
            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
        </span>
    </button>
</div>
{{ form_end(form) }}
