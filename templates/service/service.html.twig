<!DOCTYPE html>
<html lang="en">
<head>
    <base href="" />
    <title></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="assets/media/logos/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
    <link href="assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
    <link href="assets/css/gold-theme.css" rel="stylesheet" type="text/css" />
    <style>
        .bg-gold {
            background: linear-gradient(135deg, #e3c77a, #caa44c, #8c6e2f, #caa44c);
            color: white;
            border-radius: 50%;
            box-shadow: 0 0 10px rgba(202, 164, 76, 0.7),
                inset 0 0 5px rgba(255, 255, 255, 0.3);
            transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.15s ease;
        }

        .bg-gold:active {
            transform: scale(0.85) !important;
            box-shadow: 0 0 5px rgba(202, 164, 76, 0.5);
        }

        .gold-text {
            background: linear-gradient(135deg, #c79b33ff, #ffbc21ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        #food-slider .nav-link:hover {
            transform: scale(1.12);
            transition: transform .25s ease;
        }

        .card.transform {
            transition: transform .25s ease, box-shadow .25s ease;
            transform-origin: center;
        }

        .card.transform:active:not(:has(.add-to-cart-form button:active)) {
            transform: scale(1.18);
            box-shadow: 0 12px 30px rgba(0, 0, 0, .20);
            z-index: 10;
            cursor: zoom-in;
        }

        .skeleton {
            background: #eee;
            background: linear-gradient(110deg, #ececec 8%, #f5f5f5 18%, #ececec 33%);
            border-radius: 5px;
            background-size: 200% 100%;
            animation: 1.5s shine linear infinite;
        }

        @keyframes shine {
            to {
                background-position-x: -200%;
            }
        }

        .skeleton-img {
            width: 100%;
            height: 120px;
            border-radius: 0.75rem;
        }

        .skeleton-text {
            height: 1rem;
            margin-bottom: 0.5rem;
            border-radius: 0.25rem;
        }

        .skeleton-category {
            width: 80px;
            height: 85px;
            border-radius: 0.75rem;
            margin: 0 10px;
        }
        
        /* Scrolltop Gold Style */
        #kt_scrolltop {
            background: linear-gradient(135deg, #e3c77a, #caa44c, #8c6e2f, #caa44c);
            box-shadow: 0 0 10px rgba(202, 164, 76, 0.7), inset 0 0 5px rgba(255, 255, 255, 0.3);
        }
        #kt_scrolltop:hover {
            background: linear-gradient(135deg, #caa44c, #8c6e2f, #caa44c, #e3c77a);
        }
        #kt_scrolltop i {
            color: #ffffff;
        } 
    </style>
    <style>
        #kt_splash_screen {
            position: fixed;
            z-index: 99999;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            transition: opacity 0.6s ease-out, visibility 0.6s ease-out;
        }
        #kt_splash_screen.hidden {
            opacity: 0;
            visibility: hidden;
        }
        .splash-logo {
            width: 120px;
            height: auto;
            margin-bottom: 20px;
            animation: pulse-logo 2s infinite ease-in-out;
        }
        @keyframes pulse-logo {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.1); opacity: 0.8; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body id="kt_body" class="header-fixed header-tablet-and-mobile-fixed toolbar-enabled">

    <div id="kt_splash_screen">
        <img src="assets/media/ch/logoB.webp" alt="Bon Temps Cafe" class="splash-logo">
     </div>

    <script>
        window.addEventListener('load', () => {
            const splash = document.getElementById('kt_splash_screen');
            if (splash) {
                setTimeout(() => {
                    splash.classList.add('hidden');
                    setTimeout(() => splash.remove(), 600);
                }, 100);
            }
        });
    </script>
<script>
    var defaultThemeMode = "light";
    var themeMode;
    if (document.documentElement) {
        if (document.documentElement.hasAttribute("data-bs-theme-mode")) {
            themeMode = document.documentElement.getAttribute("data-bs-theme-mode");
        } else if (localStorage.getItem("data-bs-theme") !== null) {
            themeMode = localStorage.getItem("data-bs-theme");
        } else {
            themeMode = defaultThemeMode;
        }
        if (themeMode === "system") {
            themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-bs-theme", themeMode);
    }
</script>
