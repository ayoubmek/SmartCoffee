    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const handleTabClick = (e) => {
            const link = e.target.closest('[data-bs-target^="#kt_stats_widget_2_tab_"]');
            if (link) {
                e.preventDefault();
                const targetId = link.getAttribute('data-bs-target');
                
                // Remove active class from all links
                document.querySelectorAll('[data-bs-target^="#kt_stats_widget_2_tab_"]').forEach(l => l.classList.remove('active'));
                
                // Add active class to all links pointing to the same target (handles clones)
                document.querySelectorAll(`[data-bs-target="${targetId}"]`).forEach(l => l.classList.add('active'));

                const targetPane = document.querySelector(targetId);
                if (targetPane) {
                    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('show', 'active'));
                    targetPane.classList.add('show', 'active');
                }
            }
        };

        // Use event delegation for robust handling including slider clones
        document.body.addEventListener('click', handleTabClick);
    });
    </script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.add-to-cart-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const url = form.getAttribute('action');

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const data = await response.json();

                if (response.ok && data.status === 'success') {
                    showAndroidToast(data.message);

                    setTimeout(() => {
                        refreshCart();
                    }, 300);

                } else {
                    showAndroidToast(data.message || 'Erreur lors de l’ajout', true);
                }

            } catch (error) {
                showAndroidToast('Erreur de connexion', true);
                console.error(error);
            }
        });
    });
});

async function refreshCart() {
    try {
        const response = await fetch('/cart/fragment', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const html = await response.text();

        const cartContainer = document.querySelector('#cart-content');
        if (cartContainer) {
            cartContainer.style.opacity = '0.6';
            setTimeout(() => {
                cartContainer.innerHTML = html;
                cartContainer.style.opacity = '1';
            }, 150);
        }
    } catch (err) {
        console.error("Cart refresh failed", err);
    }
}

document.addEventListener('DOMContentLoaded', () => {
    // --- Swipe to Delete Logic ---
    let startX = 0;
    let currentX = 0;
    let activeItem = null;
    let isSwiping = false;

    const handleStart = (e) => {
        const item = e.target.closest('.swipe-item');
        if (!item) return;
        
        // Don't swipe if clicking on buttons or inputs
        if (e.target.closest('button, input, a')) return;

        activeItem = item;
        const content = item.querySelector('.swipe-content');
        startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        content.style.transition = 'none';
        isSwiping = true;
    };

    const handleMove = (e) => {
        if (!isSwiping || !activeItem) return;
        
        const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        currentX = clientX - startX;
        
        // Prevent horizontal scroll but allow vertical scroll if swipe is more vertical
        if (Math.abs(currentX) > 10) {
            if (e.cancelable) e.preventDefault();
        }

        const content = activeItem.querySelector('.swipe-content');
        const bg = activeItem.querySelector('.swipe-background');
        
        // Limit movement
        const moveX = currentX;
        content.style.transform = `translateX(${moveX}px)`;
        
        // Show background color and icons
        const opacity = Math.min(Math.abs(currentX) / 100, 1);
        bg.style.opacity = opacity;
        bg.style.pointerEvents = 'auto';
    };

    const handleEnd = async () => {
        if (!isSwiping || !activeItem) return;
        isSwiping = false;

        const content = activeItem.querySelector('.swipe-content');
        const bg = activeItem.querySelector('.swipe-background');
        const deleteUrl = activeItem.dataset.deleteUrl;

        content.style.transition = 'transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.1)';

        if (Math.abs(currentX) > 120) {
            // Swipe successful - fly away
            content.style.transform = `translateX(${currentX > 0 ? 150 : -150}%)`;
            activeItem.style.transition = 'all 0.4s ease';
            
            // Animation for item removal
            setTimeout(() => {
                activeItem.style.height = '0';
                activeItem.style.margin = '0';
                activeItem.style.padding = '0';
                activeItem.style.opacity = '0';
            }, 100);

            // Execute delete via AJAX
            try {
                const response = await fetch(deleteUrl, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                
                if (response.ok) {
                    showAndroidToast('Produit supprimé');
                    setTimeout(() => refreshCart(), 400);
                } else {
                    showAndroidToast('Erreur lors de la suppression', true);
                    refreshCart();
                }
            } catch (err) {
                console.error("Swipe delete failed", err);
                refreshCart(); 
            }
        } else {
            // Snap back if distance was too short
            content.style.transform = 'translateX(0)';
            bg.style.opacity = '0';
            bg.style.pointerEvents = 'none';
        }
        
        activeItem = null;
        currentX = 0;
    };

    const cartContainer = document.querySelector('#kt_drawer_chat_messenger_body');
    if (cartContainer) {
        cartContainer.addEventListener('touchstart', handleStart, {passive: false});
        cartContainer.addEventListener('touchmove', handleMove, {passive: false});
        cartContainer.addEventListener('touchend', handleEnd);
        
        // Desktop mouse support
        cartContainer.addEventListener('mousedown', handleStart);
        window.addEventListener('mousemove', handleMove);
        window.addEventListener('mouseup', handleEnd);
    }
});

function showAndroidToast(message, isError = false) {
    const toast = document.createElement('div');
    toast.className = 'android-toast';
    if (isError) toast.classList.add('error');
    toast.textContent = message;
    document.body.appendChild(toast);

    setTimeout(() => toast.classList.add('show'), 50);
    setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
    }, 2500);
}
</script>


<style>
.android-toast {
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(50px);
    background: rgba(40, 167, 69, 0.95); 
    color: #fff;
    padding: 10px 20px;
    border-radius: 25px;
    font-size: 0.95rem;
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 9999;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.android-toast.error {
    background: rgba(220, 53, 69, 0.95); 
}

.android-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}
</style>

