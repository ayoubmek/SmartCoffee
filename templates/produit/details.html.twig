<!DOCTYPE html>
<html lang="fr">
<head>
    <base href="">
    <meta charset="utf-8">
    <title>{{ produit.nom }} – Bon Temps Café</title>
    <meta name="description" content="Découvrez nos délices : {{ produit.nom }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <link rel="shortcut icon" href="{{ asset('assets/media/logos/favicon.ico') }}">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700">
    <link href="{{ asset('assets/plugins/global/plugins.bundle.css') }}" rel="stylesheet" type="text/css">
    <link href="{{ asset('assets/css/style.bundle.css') }}" rel="stylesheet" type="text/css">
    
    <style>
        body, .page-loader, #kt_body { 
            background: #ffffff !important;
            background-image: none !important;
        }
        .page-loader {
            position: fixed; inset: 0; background: #ffffff; z-index: 9999;
            display: flex; align-items: center; justify-content: center;
            transition: opacity 0.6s ease;
        }
        .page-loader.hide { opacity: 0; pointer-events: none; }
        .spinner-border { width: 3rem; height: 3rem; color: #caa44c !important; }
        .gold-text { color: #caa44c; }
        .bg-gold { background-color: #caa44c; }
        .btn-gold {
            background: linear-gradient(135deg, #e3c77a, #caa44c);
            color: #fff; border: 0;
            transition: all 0.3s ease;
        }
        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(202, 164, 76, 0.4);
            color: #fff;
        }
        .product-image-container {
            /* No background or shadow */
            border-radius: 20px;
            overflow: hidden;
            position: relative;
        }
        .product-image {
            width: 100%;
            height: auto;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .product-image:hover { transform: scale(1.05); }
        .card-details {
            border-radius: 24px;
            border: none;
            box-shadow: 0 0 0 transparent;
            background: transparent;
        }
        .info-box {
            background: #ffffff;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
            margin-bottom: 1.5rem;
        }
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 100;
        }
        .wishlist-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 100;
        }
    </style>
</head>

<body id="kt_body" class="header-fixed header-tablet-and-mobile-fixed toolbar-enabled">

    <!-- Loader -->
    <div id="page-preloader" class="page-loader">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>

    <div class="d-flex flex-column flex-root">
        <div class="page d-flex flex-row flex-column-fluid">
            <div class="wrapper d-flex flex-column flex-row-fluid pt-3">
                <div class="content flex-column-fluid">
                    <div class="container-xxl">
                        


                        <div class="row g-5 g-xl-10">
                            <!-- Left: Image -->
                            <div class="col-lg-6">
                                <div class="product-image-container mb-5 mb-lg-0">
                                    <div class="position-absolute top-0 end-0 m-4 z-index-2">
                                        <button class="btn btn-icon btn-light-danger btn-active-danger w-40px h-40px rounded-circle shadow-sm">
                                            <i class="ki-duotone ki-heart fs-2"><span class="path1"></span><span class="path2"></span></i>
                                        </button>
                                    </div>
                                    {% if produit.reduction %}
                                        <div class="position-absolute top-0 start-0 m-4 z-index-2">
                                            <span class="badge badge-danger fw-bold fs-6 px-3 py-2 shadow-sm">-{{ produit.reduction }}%</span>
                                        </div>
                                    {% endif %}
                                    <img src="{{ asset(produit.image) }}" alt="{{ produit.nom }}" class="product-image">
                                </div>
                            </div>

                            <!-- Right: Details -->
                            <div class="col-lg-6">
                                <div class="d-flex flex-column h-100 justify-content-center">
                                    
                                    <div class="info-box">
                                        <div class="d-flex justify-content-between align-items-start mb-4">
                                            <div>
                                                <span class="badge badge-light-warning fw-bold fs-7 mb-2">{{ produit.categorie.nom|upper }}</span>
                                                <h1 class="text-gray-900 fw-bolder fs-2x mb-2">{{ produit.nom }}</h1>
                                                <div class="d-flex align-items-center mb-1">
                                                     <i class="ki-duotone ki-star text-warning fs-4 me-1"></i>
                                                     <i class="ki-duotone ki-star text-warning fs-4 me-1"></i>
                                                     <i class="ki-duotone ki-star text-warning fs-4 me-1"></i>
                                                     <i class="ki-duotone ki-star text-warning fs-4 me-1"></i>
                                                     <i class="ki-duotone ki-star-half text-warning fs-4 me-2"></i>
                                                     <span class="text-gray-500 fw-semibold fs-7">(4.8 avis)</span>
                                                </div>
                                            </div>
                                            <div class="d-flex flex-column align-items-end">
                                                <span class="fs-2x fw-bold gold-text">{{ produit.prix|number_format(0, ',', ' ') }} <span class="fs-4 text-gray-600">DT</span></span>
                                                {% if produit.prixAncien %}
                                                    <span class="text-gray-400 text-decoration-line-through fs-6">{{ produit.prixAncien|number_format(0, ',', ' ') }} DT</span>
                                                {% endif %}
                                            </div>
                                        </div>

                                        <div class="separator separator-dashed my-5"></div>

                                        <div class="mb-5">
                                            <h3 class="fw-bold text-gray-800 mb-3 fs-5">Description</h3>
                                            <p class="text-gray-600 fs-6 fw-semibold lh-lg mb-0">
                                                {{ produit.description|default("Aucune description disponible pour ce produit.")|nl2br }}
                                            </p>
                                        </div>

                                        {% if produit.tailles|length > 0 %}
                                            <div class="mb-6">
                                                <h3 class="fw-bold text-gray-800 mb-3 fs-5">Options</h3>
                                                <div class="d-flex flex-wrap gap-3">
                                                    {% for taille in produit.tailles %}
                                                        <label class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex align-items-center p-3" style="cursor:default">
                                                            <span class="fs-6 fw-bold text-gray-800 me-2">{{ taille.libelle }}</span>
                                                            <span class="badge badge-light-primary fs-7">{{ taille.prix|number_format(0, ',', ' ') }} DT</span>
                                                        </label>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <!-- Action Card -->
                                    <div class="info-box bg-light-primary border-primary border-dashed border-1">
                                        <form action="{{ path('cart_add', { id: produit.id }) }}" method="post" class="d-flex flex-column flex-sm-row gap-4 align-items-center">
                                            
                                            <!-- Quantity Stepper -->
                                            <div class="position-relative w-100 w-sm-150px">
                                                <button type="button" class="btn btn-icon btn-active-color-gray-700 position-absolute translate-middle-y top-50 start-0" onclick="document.querySelector('input[name=qty]').stepDown()">
                                                    <i class="ki-duotone ki-minus fs-2"></i>
                                                </button>
                                                <input type="number" class="form-control form-control-solid border-0 text-center" name="qty" value="1" min="1" max="10" readonly style="font-weight: 600; font-size: 1.1rem;">
                                                <button type="button" class="btn btn-icon btn-active-color-gray-700 position-absolute translate-middle-y top-50 end-0" onclick="document.querySelector('input[name=qty]').stepUp()">
                                                    <i class="ki-duotone ki-plus fs-2"></i>
                                                </button>
                                            </div>

                                            <button type="submit" class="btn btn-gold w-100 flex-grow-1 py-4 fs-4 fw-bold">
                                                <i class="ki-duotone ki-handcart fs-2 me-2"><span class="path1"></span><span class="path2"></span></i>
                                                Ajouter au panier
                                            </button>
                                        </form>
                                    </div>

                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="{{ asset('assets/plugins/global/plugins.bundle.js') }}"></script>
    <script src="{{ asset('assets/js/scripts.bundle.js') }}"></script>
    <script>
        window.addEventListener("load", function() {
            const loader = document.getElementById("page-preloader");
            if(loader) {
                setTimeout(() => {
                    loader.classList.add("hide");
                    setTimeout(() => loader.remove(), 600);
                }, 500); 
            }
        });
    </script>
</body>
</html>
